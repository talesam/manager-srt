# File: usr/share/jellyfix/gui/windows/help_window.py, line: 84
#: /home/talesam/Servidor/GitHub/talesam/jellyfix/usr/share/jellyfix/gui/windows/help_window.py:88
msgid ""
"Jellyfix automatically organizes your media library following Jellyfin naming conventions:\n"
"\n"
"• <b>Renames files</b> to Jellyfin standard format\n"
"• <b>Organizes episodes</b> into Season folders\n"
"• <b>Manages subtitles</b>: renames, removes foreign languages, adds language codes\n"
"• <b>Fetches metadata</b> from TMDB/TVDB\n"
"• <b>Detects and adds quality tags</b> (1080p, 720p, etc)\n"
"• <b>Adds provider IDs</b> to folder names ([tmdbid-12345])"
msgstr ""
"Jellyfix automatycznie porządkuje Twoją bibliotekę multimediów zgodnie z konwencjami nazewnictwa "
"Jellyfin:\n"
"\n"
"• <b>Zmienia nazwy plików</b> na standardowy format Jellyfin\n"
"• <b>Organizuje odcinki</b> w foldery sezonów\n"
"• <b>Zarządza napisami</b>: zmienia nazwy, usuwa języki obce, dodaje kody języków\n"
"• <b>Pobiera metadane</b> z TMDB/TVDB\n"
"• <b>Wykrywa i dodaje tagi jakości</b> (1080p, 720p itp.)\n"
"• <b>Dodaje identyfikatory dostawców</b> do nazw folderów ([tmdbid-12345])"
# File: usr/share/jellyfix/gui/windows/help_window.py, line: 96
#: /home/talesam/Servidor/GitHub/talesam/jellyfix/usr/share/jellyfix/gui/windows/help_window.py:102
msgid "Examples"
msgstr "Przykłady"
# File: usr/share/jellyfix/gui/windows/help_window.py, line: 104
#: /home/talesam/Servidor/GitHub/talesam/jellyfix/usr/share/jellyfix/gui/windows/help_window.py:104
msgid ""
"<b>Movies:</b>\n"
"  Before: movie.name.2023.1080p.bluray.mkv\n"
"  After:  Movie Name (2023) [tmdbid-12345]/Movie Name (2023) - 1080p.mkv\n"
"\n"
"<b>TV Shows:</b>\n"
"  Before: show.name.s01e05.720p.mkv\n"
"  After:  Show Name (2024) [tmdbid-67890]/Season 01/Show Name - S01E05 - 720p.mkv\n"
"\n"
"<b>Subtitles:</b>\n"
"  • Renames: .por2.srt → .por.srt, .eng3.srt → .eng.srt\n"
"  • Adds language codes: subtitle.srt → Movie Name.por.srt\n"
"  • Removes foreign languages (keeps configured languages only)\n"
"  • <b>NEVER</b> removes .forced.srt files"
msgstr ""
"<b>Filmy:</b>\n"
"  Przed: movie.name.2023.1080p.bluray.mkv\n"
"  Po:  Nazwa Filmu (2023) [tmdbid-12345]/Nazwa Filmu (2023) - 1080p.mkv\n"
"\n"
"<b>Seriale:</b>\n"
"  Przed: show.name.s01e05.720p.mkv\n"
"  Po:  Nazwa Serii (2024) [tmdbid-67890]/Sezon 01/Nazwa Serii - S01E05 - 720p.mkv\n"
"\n"
"<b>Napisy:</b>\n"
"  • Zmienia nazwy: .por2.srt → .por.srt, .eng3.srt → .eng.srt\n"
"  • Dodaje kody językowe: subtitle.srt → Nazwa Filmu.por.srt\n"
"  • Usuwa obce języki (zachowuje tylko skonfigurowane języki)\n"
"  • <b>NIGDY</b> nie usuwa plików .forced.srt"
# File: usr/share/jellyfix/gui/windows/help_window.py, line: 113
#: /home/talesam/Servidor/GitHub/talesam/jellyfix/usr/share/jellyfix/gui/windows/help_window.py:123
msgid "How to Use"
msgstr "Jak używać"
# File: usr/share/jellyfix/gui/windows/help_window.py, line: 113
#: /home/talesam/Servidor/GitHub/talesam/jellyfix/usr/share/jellyfix/gui/windows/help_window.py:125
msgid ""
"<b>1. Configure TMDB API Key (recommended)</b>\n"
"   Menu → Configure API Keys → Follow the tutorial\n"
"   This enables metadata fetching and poster downloads.\n"
"\n"
"<b>2. Scan Library</b>\n"
"   Click \"Scan Library\" on Dashboard\n"
"   Select your media folder\n"
"   Review the scan results\n"
"\n"
"<b>3. Review Operations</b>\n"
"   Switch to \"Operations\" tab\n"
"   Preview what will be changed\n"
"   Select operations to see details\n"
"\n"
"<b>4. Execute</b>\n"
"   Click \"Process Files\"\n"
"   Confirm the operation\n"
"   Files will be renamed and organized\n"
"\n"
"<b>Tip:</b> Always review the preview before executing!"
msgstr ""
"<b>1. Skonfiguruj klucz API TMDB (zalecane)</b>\n"
"   Menu → Skonfiguruj klucze API → Postępuj zgodnie z samouczkiem\n"
"   Umożliwia to pobieranie metadanych i okładek.\n"
"\n"
"<b>2. Skanuj bibliotekę</b>\n"
"   Kliknij „Skanuj bibliotekę” na pulpicie\n"
"   Wybierz folder multimediów\n"
"   Przejrzyj wyniki skanowania\n"
"\n"
"<b>3. Przejrzyj operacje</b>\n"
"   Przełącz się na kartę „Operacje”\n"
"   Podgląd zmian, które zostaną wprowadzone\n"
"   Wybierz operacje, aby zobaczyć szczegóły\n"
"\n"
"<b>4. Wykonaj</b>\n"
"   Kliknij „Przetwórz pliki”\n"
"   Potwierdź operację\n"
"   Pliki zostaną zmienione i uporządkowane\n"
"\n"
"<b>Wskazówka:</b> Zawsze sprawdzaj podgląd przed wykonaniem!"
# File: usr/share/jellyfix/gui/windows/help_window.py, line: 137
#: /home/talesam/Servidor/GitHub/talesam/jellyfix/usr/share/jellyfix/gui/windows/help_window.py:153
msgid ""
"Configure Jellyfix behavior:\n"
"\n"
"• <b>Subtitle Handling:</b> Rename variants, add language codes, remove foreign\n"
"• <b>Kept Languages:</b> Choose which subtitle languages to keep\n"
"• <b>Metadata:</b> Enable/disable TMDB fetching\n"
"• <b>Quality Tags:</b> Add resolution tags to filenames\n"
"• <b>ffprobe:</b> Use ffprobe for accurate quality detection"
msgstr ""
"Skonfiguruj zachowanie Jellyfix:\n"
"\n"
"• <b>Obsługa napisów:</b> Zmieniaj nazwy wariantów, dodawaj kody języków, usuwaj obce\n"
"• <b>Zachowane języki:</b> Wybierz, które języki napisów zachować\n"
"• <b>Metadane:</b> Włącz/wyłącz pobieranie z TMDB\n"
"• <b>Tagi jakości:</b> Dodawaj tagi rozdzielczości do nazw plików\n"
"• <b>ffprobe:</b> Użyj ffprobe do dokładnego wykrywania jakości"
