# File: usr/share/jellyfix/gui/windows/help_window.py, line: 104
#: /home/talesam/Servidor/GitHub/talesam/jellyfix/usr/share/jellyfix/gui/windows/help_window.py:104
msgid ""
"<b>Movies:</b>\n"
"  Before: movie.name.2023.1080p.bluray.mkv\n"
"  After:  Movie Name (2023) [tmdbid-12345]/Movie Name (2023) - 1080p.mkv\n"
"\n"
"<b>TV Shows:</b>\n"
"  Before: show.name.s01e05.720p.mkv\n"
"  After:  Show Name (2024) [tmdbid-67890]/Season 01/Show Name - S01E05 - 720p.mkv\n"
"\n"
"<b>Subtitles:</b>\n"
"  • Renames: .por2.srt → .por.srt, .eng3.srt → .eng.srt\n"
"  • Adds language codes: subtitle.srt → Movie Name.por.srt\n"
"  • Removes foreign languages (keeps configured languages only)\n"
"  • <b>NEVER</b> removes .forced.srt files"
msgstr ""
"<b>Filmler:</b>\n"
"  Önce: film.adi.2023.1080p.bluray.mkv\n"
"  Sonra:  Film Adı (2023) [tmdbid-12345]/Film Adı (2023) - 1080p.mkv\n"
"\n"
"<b>TV Şovları:</b>\n"
"  Önce: dizi.adi.s01e05.720p.mkv\n"
"  Sonra:  Dizi Adı (2024) [tmdbid-67890]/Sezon 01/Dizi Adı - S01E05 - 720p.mkv\n"
"\n"
"<b>Altyazılar:</b>\n"
"  • Yeniden adlandırır: .por2.srt → .por.srt, .eng3.srt → .eng.srt\n"
"  • Dil kodları ekler: altyazi.srt → Film Adı.por.srt\n"
"  • Yabancı dilleri kaldırır (sadece yapılandırılmış dilleri korur)\n"
"  • <b>ASLA</b> .forced.srt dosyalarını kaldırmaz"
# File: usr/share/jellyfix/gui/windows/help_window.py, line: 113
#: /home/talesam/Servidor/GitHub/talesam/jellyfix/usr/share/jellyfix/gui/windows/help_window.py:123
msgid "How to Use"
msgstr "Nasıl Kullanılır"
# File: usr/share/jellyfix/gui/windows/help_window.py, line: 113
#: /home/talesam/Servidor/GitHub/talesam/jellyfix/usr/share/jellyfix/gui/windows/help_window.py:125
msgid ""
"<b>1. Configure TMDB API Key (recommended)</b>\n"
"   Menu → Configure API Keys → Follow the tutorial\n"
"   This enables metadata fetching and poster downloads.\n"
"\n"
"<b>2. Scan Library</b>\n"
"   Click \"Scan Library\" on Dashboard\n"
"   Select your media folder\n"
"   Review the scan results\n"
"\n"
"<b>3. Review Operations</b>\n"
"   Switch to \"Operations\" tab\n"
"   Preview what will be changed\n"
"   Select operations to see details\n"
"\n"
"<b>4. Execute</b>\n"
"   Click \"Process Files\"\n"
"   Confirm the operation\n"
"   Files will be renamed and organized\n"
"\n"
"<b>Tip:</b> Always review the preview before executing!"
msgstr ""
"<b>1. TMDB API Anahtarını Yapılandırın (önerilir)</b>\n"
"   Menü → API Anahtarlarını Yapılandır → Eğiticiyi takip edin\n"
"   Bu, meta veri getirme ve poster indirmeyi etkinleştirir.\n"
"\n"
"<b>2. Kitaplığı Tara</b>\n"
"   Kontrol Paneli'nde \"Kitaplığı Tara\"ya tıklayın\n"
"   Medya klasörünüzü seçin\n"
"   Tarama sonuçlarını inceleyin\n"
"\n"
"<b>3. İşlemleri İnceleyin</b>\n"
"   \"İşlemler\" sekmesine geçin\n"
"   Ne değişeceğini önizleyin\n"
"   Ayrıntıları görmek için işlemleri seçin\n"
"\n"
"<b>4. Çalıştırın</b>\n"
"   \"Dosyaları İşle\"ye tıklayın\n"
"   İşlemi onaylayın\n"
"   Dosyalar yeniden adlandırılacak ve düzenlenecek\n"
"\n"
"<b>İpucu:</b> Çalıştırmadan önce her zaman önizlemeyi inceleyin!"
# File: usr/share/jellyfix/gui/windows/help_window.py, line: 137
#: /home/talesam/Servidor/GitHub/talesam/jellyfix/usr/share/jellyfix/gui/windows/help_window.py:153
msgid ""
"Configure Jellyfix behavior:\n"
"\n"
"• <b>Subtitle Handling:</b> Rename variants, add language codes, remove foreign\n"
"• <b>Kept Languages:</b> Choose which subtitle languages to keep\n"
"• <b>Metadata:</b> Enable/disable TMDB fetching\n"
"• <b>Quality Tags:</b> Add resolution tags to filenames\n"
"• <b>ffprobe:</b> Use ffprobe for accurate quality detection"
msgstr ""
"Jellyfix davranışını yapılandırın:\n"
"\n"
"• <b>Altyazı İşleme:</b> Varyantları yeniden adlandır, dil kodları ekle, yabancıları kaldır\n"
"• <b>Korunan Diller:</b> Hangi altyazı dillerinin korunacağını seçin\n"
"• <b>Meta Veriler:</b> TMDB getirmeyi etkinleştirin/devre dışı bırakın\n"
"• <b>Kalite Etiketleri:</b> Dosya adlarına çözünürlük etiketleri ekleyin\n"
"• <b>ffprobe:</b> Doğru kalite algılama için ffprobe kullanın"
