# File: usr/share/jellyfix/gui/windows/help_window.py, line: 113
#: /home/talesam/Servidor/GitHub/talesam/jellyfix/usr/share/jellyfix/gui/windows/help_window.py:125
msgid ""
"<b>1. Configure TMDB API Key (recommended)</b>\n"
"   Menu → Configure API Keys → Follow the tutorial\n"
"   This enables metadata fetching and poster downloads.\n"
"\n"
"<b>2. Scan Library</b>\n"
"   Click \"Scan Library\" on Dashboard\n"
"   Select your media folder\n"
"   Review the scan results\n"
"\n"
"<b>3. Review Operations</b>\n"
"   Switch to \"Operations\" tab\n"
"   Preview what will be changed\n"
"   Select operations to see details\n"
"\n"
"<b>4. Execute</b>\n"
"   Click \"Process Files\"\n"
"   Confirm the operation\n"
"   Files will be renamed and organized\n"
"\n"
"<b>Tip:</b> Always review the preview before executing!"
msgstr ""
"<b>1. Configureer TMDB API-sleutel (aanbevolen)</b>\n"
"   Menu → API-sleutels configureren → Volg de tutorial\n"
"   Dit maakt het ophalen van metadata en downloaden van posters mogelijk.\n"
"\n"
"<b>2. Bibliotheek scannen</b>\n"
"   Klik op \"Bibliotheek scannen\" op het dashboard\n"
"   Selecteer uw mediamap\n"
"   Bekijk de scanresultaten\n"
"\n"
"<b>3. Bewerkingen bekijken</b>\n"
"   Schakel naar het tabblad \"Bewerkingen\"\n"
"   Bekijk een voorvertoning van wat er zal worden gewijzigd\n"
"   Selecteer bewerkingen om details te zien\n"
"\n"
"<b>4. Uitvoeren</b>\n"
"   Klik op \"Bestanden verwerken\"\n"
"   Bevestig de bewerking\n"
"   Bestanden worden hernoemd en georganiseerd\n"
"\n"
"<b>Tip:</b> Bekijk altijd de voorvertoning vóór het uitvoeren!"
