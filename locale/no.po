# File: usr/share/jellyfix/gui/windows/help_window.py, line: 84
#: /home/talesam/Servidor/GitHub/talesam/jellyfix/usr/share/jellyfix/gui/windows/help_window.py:88
msgid ""
"Jellyfix automatically organizes your media library following Jellyfin naming conventions:\n"
"\n"
"• <b>Renames files</b> to Jellyfin standard format\n"
"• <b>Organizes episodes</b> into Season folders\n"
"• <b>Manages subtitles</b>: renames, removes foreign languages, adds language codes\n"
"• <b>Fetches metadata</b> from TMDB/TVDB\n"
"• <b>Detects and adds quality tags</b> (1080p, 720p, etc)\n"
"• <b>Adds provider IDs</b> to folder names ([tmdbid-12345])"
msgstr ""
"Jellyfix organiserer automatisk mediebiblioteket ditt etter Jellyfins navnekonvensjoner:\n"
"\n"
"• <b>Gir nytt navn til filer</b> etter Jellyfins standardformat\n"
"• <b>Organiserer episoder</b> i sesongmapper\n"
"• <b>Håndterer undertekster</b>: gir nytt navn, fjerner fremmedspråk, legger til språkkoder\n"
"• <b>Henter metadata</b> fra TMDB/TVDB\n"
"• <b>Oppdager og legger til kvalitetsmerker</b> (1080p, 720p, osv.)\n"
"• <b>Legger til leverandør-ID-er</b> i mappenavn ([tmdbid-12345])"
# File: usr/share/jellyfix/gui/windows/help_window.py, line: 96
